# Copy to .env.local and fill in. .env.local is gitignored: never commit real values.

# Open demo: the login page shows a selector for the four synthetic users and
# needs no password. Sessions, roles and ownership checks stay fully active.
# Set to 0 to require the passwords below instead.
DEMO_OPEN=1

# Password logins (used when DEMO_OPEN is not 1). Pick your own, 10+ characters.
# Customers: emma, sam, jef  -> DEMO_PASSWORD
# Staff control room: analyst -> STAFF_PASSWORD
DEMO_PASSWORD=
STAFF_PASSWORD=

# Only set this when the app runs behind a reverse proxy that sets
# X-Forwarded-For. Without it, forwarded headers are ignored for rate limiting
# (a client could otherwise forge a fresh "IP" on every request).
# TRUST_PROXY=1

# Optional: Claude for sensemaking, moment copy and the intent compiler.
# Without it the app runs on deterministic offline heuristics.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# LLM_DISABLED=1

# Optional: ElevenLabs text-to-speech for the voice channel (Jef).
# Without it the browser's built-in speech synthesis is used.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_multilingual_v2
